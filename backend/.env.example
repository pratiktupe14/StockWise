# =========================================================================
# StockWise Backend - Production & Development Configuration
# All values shown below are safe placeholders for deployment.
# =========================================================================

# Application Environment
ENVIRONMENT=production
DEBUG=False
API_V1_PREFIX=/api
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Security & CORS
# In production, specify exact domain origins separated by comma (no wildcard with credentials)
ALLOWED_ORIGINS=https://stockwise.company.internal,https://admin.stockwise.internal

# Authentication & Authorization (Supabase Auth & RBAC)
# Set REQUIRE_AUTH=True in production to strictly enforce Bearer JWT verification
REQUIRE_AUTH=True
# Set ALLOW_DEMO_AUTH=False in production to reject development demo persona tokens
ALLOW_DEMO_AUTH=False
# Supabase JWT Secret from Supabase Dashboard > Project Settings > API > JWT Settings
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
SUPABASE_JWT_ALGORITHM=HS256
SUPABASE_JWT_AUDIENCE=authenticated

# Supabase API Settings
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_public_key

# Database Connection
# Supabase PostgreSQL Session Pooler (port 5432, sslmode=require)
DATABASE_URL=postgresql+psycopg2://postgres.your-project-ref:your_strong_db_password@aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require
DB_CONNECT_TIMEOUT_SECONDS=10

# Operational Reliability & Concurrency Safeguards
ENABLE_IDEMPOTENCY=True
MAX_FILE_UPLOAD_SIZE_MB=10
