# =========================================================================
# StockWise Frontend - Environment Configuration
# Safe placeholders for production & local development.
# =========================================================================

# Backend API Base URL (defaults to '/api' for reverse proxy / Nginx / Vite proxy)
VITE_API_BASE_URL=/api

# Supabase Auth Configuration (Client-side)
# Obtain from Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Security & Demo Persona Isolation
# Set to 'false' in production deployments to eliminate development persona switcher
VITE_ALLOW_DEMO_AUTH=false
VITE_APP_ENV=production
